{
  "name": "recigle",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "opera >= 73",
    "safari >= 14.1"
  ],
  "scripts": {
    "build": "next build",
    "check": "biome check --write .",
    "dev": "next dev --turbopack",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "knip": "knip",
    "secretlint": "secretlint '**/*'",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lighthouse": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "esbuild-wasm": "^0.28.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "use-pwa": "^3.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lhci/cli": "^0.15.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "secretlint": "^13.0.4",
    "typescript": "^7.0.2"
  }
}
